#!/usr/bin/env bash
# gitflow guard — installed via .pre-commit-config.yaml (local pre-commit hook).
#
# Blocks `git commit` itself while checked out on master or dev, except for
# the commit that finalizes an in-progress merge (git sets .git/MERGE_HEAD
# while completing that commit). This is the commit-time companion to
# scripts/git-hooks/pre-push, which only ever caught this at push time —
# by then the "wrong" commit already exists on the branch and has to be
# cleaned up after the fact. Catching it here means git refuses the commit
# before it's ever created.
#
# Also runs outside of a real `git commit` — e.g. `pre-commit run --all-files`
# in CI (.github/workflows/pre-commit.yml), which lints an already-finished
# checkout instead of creating a commit. MERGE_HEAD is deleted the moment a
# merge commit is finalized, so it never exists in that mode — a bare
# MERGE_HEAD check would reject every merge commit ever pushed to master.
# Told apart from a live commit by the index: a real `git commit` always has
# a pending change staged against HEAD, whereas a CI/manual `pre-commit run`
# lints a clean tree with nothing staged. Only in the latter case do we fall
# back to judging the already-made HEAD commit by its parent count instead.
#
# Bypass (deliberate emergencies only): git commit --no-verify

set -euo pipefail

protected_branches="master dev"

branch="$(git symbolic-ref --short -q HEAD || true)"
[ -z "$branch" ] && exit 0  # detached HEAD — not on a protected branch

is_protected=""
for b in $protected_branches; do
    [ "$branch" = "$b" ] && is_protected=1
done
[ -z "$is_protected" ] && exit 0

# Allow the commit that finalizes an in-progress merge.
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && exit 0

if git diff --cached --quiet; then
    # Nothing staged: not a live commit. Judge the already-made HEAD commit.
    git rev-parse -q --verify HEAD^2 >/dev/null 2>&1 && exit 0
fi

echo "error: refusing to commit directly to '$branch'." >&2
echo "       $branch only accepts merge commits (PR/merge), not direct commits." >&2
echo "       Create a feature branch instead, e.g.:" >&2
echo "         git checkout -b fix/your-change" >&2
echo "       (deliberate override: git commit --no-verify)" >&2
exit 1
