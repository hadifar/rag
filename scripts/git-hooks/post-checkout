#!/usr/bin/env bash
# stale-branch warning — installed via .pre-commit-config.yaml
# (local post-checkout hook).
#
# When you switch onto master or dev, fetches quietly and warns if the
# branch you just landed on is behind its upstream. Advisory only — this
# hook fires after the checkout already happened, so it can't block anything.
#
# Deliberately ignores git's post-checkout $1/$2/$3 (prev_head, new_head,
# is_branch_checkout): pre-commit's `language: script` hooks don't forward
# them (they're consumed internally for pre-commit's own file-filtering,
# not passed through to script entries), so this derives everything it
# needs from git state directly instead — which also makes it correct
# whether it's run as a raw git hook or via pre-commit.

set -euo pipefail

watched_branches="master dev"

branch="$(git symbolic-ref --short -q HEAD || true)"
[ -z "$branch" ] && exit 0  # detached HEAD

is_watched=""
for b in $watched_branches; do
    [ "$branch" = "$b" ] && is_watched=1
done
[ -z "$is_watched" ] && exit 0

upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
[ -z "$upstream" ] && exit 0  # no upstream configured, nothing to compare

remote="${upstream%%/*}"
git fetch --quiet "$remote" "$branch" 2>/dev/null || exit 0

behind=$(git rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)

if [ "$behind" -gt 0 ]; then
    echo "warning: '$branch' is $behind commit(s) behind '$upstream'." >&2
    echo "         run: git pull" >&2
fi

exit 0
