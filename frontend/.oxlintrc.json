{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "fetch",
        "message": "Call the backend through shared/api/client.ts (request, requestJson, authFetch): it adds the token and refreshes it."
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**/api.generated"
            ],
            "message": "Backend shapes come from shared/types/api.ts, which names each one."
          },
          {
            "group": [
              "**/shared/types/*"
            ],
            "message": "Import shared types from '@/shared/types', not a single file in it."
          },
          {
            "group": [
              "**/features/*/**"
            ],
            "message": "Use another feature only through its public API ('@/features/<name>'), never a file inside it."
          },
          {
            "group": [
              "**/features/chat"
            ],
            "message": "Only the lazily loaded pages/ChatPage imports the chat feature: it pulls in the markdown renderer."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/shared/api/client.ts",
        "src/features/auth/api/auth.ts"
      ],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      "files": [
        "src/features/*/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/api.generated"
                ],
                "message": "Backend shapes come from shared/types/api.ts, which names each one."
              },
              {
                "group": [
                  "**/shared/types/*"
                ],
                "message": "Import shared types from '@/shared/types', not a single file in it."
              },
              {
                "group": [
                  "**/features/*/**"
                ],
                "message": "Use another feature only through its public API ('@/features/<name>'), never a file inside it."
              },
              {
                "group": [
                  "**/features/chat"
                ],
                "message": "Only the lazily loaded pages/ChatPage imports the chat feature: it pulls in the markdown renderer."
              },
              {
                "group": [
                  "../**"
                ],
                "message": "Leave a feature only through '@/…' imports, so a reach into another feature's files is caught."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/components/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/api.generated"
                ],
                "message": "Backend shapes come from shared/types/api.ts, which names each one."
              },
              {
                "group": [
                  "**/shared/types/*"
                ],
                "message": "Import shared types from '@/shared/types', not a single file in it."
              },
              {
                "group": [
                  "**/features/*/**"
                ],
                "message": "Use another feature only through its public API ('@/features/<name>'), never a file inside it."
              },
              {
                "group": [
                  "**/features/chat"
                ],
                "message": "Only the lazily loaded pages/ChatPage imports the chat feature: it pulls in the markdown renderer."
              },
              {
                "group": [
                  "../../**"
                ],
                "message": "Leave a feature only through '@/…' imports, so a reach into another feature's files is caught."
              },
              {
                "group": [
                  "**/api/**"
                ],
                "message": "Components and pages only present: reach the server through a hook or context."
              },
              {
                "group": [
                  "@tanstack/react-query"
                ],
                "message": "Components and pages only present: server data comes through a feature's hook."
              }
            ]
          }
        ]
      }
    },
    {
