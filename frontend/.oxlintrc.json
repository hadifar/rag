{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-globals": [
      "error",
      {
        "name": "fetch",
        "message": "Call the backend through api/client.ts (request, requestJson, authFetch): it adds the token and refreshes it."
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/types/*"],
            "message": "Import types from the types index ('../types'), not a single file in it."
          },
          {
            "group": ["**/api.generated"],
            "message": "Backend shapes come from types/api.ts, which names each one."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/api/client.ts", "src/api/auth.ts"],
      "rules": { "no-restricted-globals": "off" }
    },
    {
      "files": ["src/components/**", "src/pages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/api/*"],
                "message": "Components and pages only present: reach the server through a hook or context."
              },
              {
                "group": ["**/types/*"],
                "message": "Import types from the types index ('../types'), not a single file in it."
              },
              {
                "group": ["**/api.generated"],
                "message": "Backend shapes come from types/api.ts, which names each one."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/types/api.ts"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["src/hooks/**", "src/context/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/components/**", "**/pages/**"],
                "message": "Hooks and context are the logic layer: they don't render or depend on presentation."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/api/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/hooks/**", "**/context/**", "**/components/**", "**/pages/**"],
                "message": "api/ only talks to the backend: no framework state, no presentation."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/utils/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/api/**", "**/hooks/**", "**/context/**", "**/components/**", "**/pages/**"],
                "message": "utils/ is pure helpers: no network, no framework state, no presentation."
              }
            ]
          }
        ]
      }
    }
  ]
}
