# llm
LLM__BACKEND=<openai or azure_openai>
LLM__API_KEY=<your key>
## openai specific
LLM__MODEL=gpt-4o-mini
LLM__EMBEDDING_MODEL=text-embedding-3-small
## azure specific
LLM__ENDPOINT=<>
LLM__DEPLOYMENT=<>
LLM__API_VERSION=<>
LLM__EMBEDDING_DEPLOYMENT=<a text-embedding-3-* deployment>

# obs
OBSERVABILITY__BACKEND=<langfuse or logging>
OBSERVABILITY__PUBLIC_KEY=<your key>
OBSERVABILITY__SECRET_KEY=<your key>
OBSERVABILITY__HOST=https://cloud.langfuse.com

# db
DATABASE__PASSWORD=<password>
DATABASE__SSLMODE=disable   # the local compose Postgres has no TLS; leave unset (verify-full) elsewhere
# DATABASE__HOST / __PORT / __NAME / __USER default to localhost / 5432 / rag / rag

# auth
AUTH__JWT_SECRET=<random secret, e.g. `openssl rand -hex 32`>
