OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=<your key>

PINECONE_API_KEY=<your key>
PINECONE_DENSE_INDEX_NAME=atlasflow-dense-kb
PINECONE_SPARSE_INDEX_NAME=atlasflow-sparse-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=default
PINECONE_DENSE_MODEL=llama-text-embed-v2
PINECONE_SPARSE_MODEL=pinecone-sparse-english-v0

LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=<your key>
LANGFUSE_SECRET_KEY=<your key>
LANGFUSE_HOST=https://cloud.langfuse.com

CHECKPOINTER_BACKEND=postgres
DATABASE_URL=postgresql://rag:<password>@postgres:5432/rag
