# llm
LLM__BACKEND=<openai or azure_openai>
LLM__API_KEY=<your key>
## openai specific
LLM__MODEL=gpt-4o-mini
LLM__EMBEDDING_MODEL=text-embedding-3-small
## azure specific
LLM__ENDPOINT=<>
LLM__DEPLOYMENT=<>
LLM__API_VERSION=<>
LLM__EMBEDDING_DEPLOYMENT=<a text-embedding-3-* deployment>

# obs
OBSERVABILITY__BACKEND=<langfuse or logging>
OBSERVABILITY__PUBLIC_KEY=<your key>
OBSERVABILITY__SECRET_KEY=<your key>
OBSERVABILITY__HOST=https://cloud.langfuse.com

# db (users, conversations, chunks (needs pgvector))
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# auth (use random secret, e.g. `openssl rand -hex 32`)
AUTH__JWT_SECRET=dev-only-insecure-jwt-secret-change-me
