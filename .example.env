# llm
LLM__BACKEND=<openai or azure_openai>
LLM__API_KEY=<your key>
## openai specific
LLM__MODEL=gpt-6-luna
LLM__EMBEDDING_MODEL=text-embedding-3-small
## azure specific
LLM__ENDPOINT=<>
LLM__DEPLOYMENT=<>
LLM__API_VERSION=<>
LLM__EMBEDDING_DEPLOYMENT=<a text-embedding-3-* deployment>
## tuning (optional, both backends)
# LLM__TEMPERATURE=0.2
# LLM__RETRY_ATTEMPTS=3
## reasoning (optional): only for a reasoning model (gpt-5-mini, o4-mini, ...);
## streams its reasoning summary to the chat and ignores TEMPERATURE
## <minimal, low, medium or high>
LLM__REASONING_EFFORT=medium
# retrieval & guards tuning (optional)
# RETRIEVAL__SUMMARY_WEIGHT=0.5
# RETRIEVAL__RETRIEVAL_CANDIDATES=10
# RETRIEVAL__RERANK_CANDIDATES=3

# caches in Postgres (optional): query embeddings, search results, off-topic verdicts
# CACHE__ENABLED=true
# CACHE__EMBEDDING_TTL_DAYS=7
# CACHE__SEARCH_TTL_DAYS=7
# CACHE__VERDICT_TTL_DAYS=7

# obs
OBSERVABILITY__BACKEND=<langfuse or logging>
OBSERVABILITY__PUBLIC_KEY=<your key>
OBSERVABILITY__SECRET_KEY=<your key>
OBSERVABILITY__HOST=https://cloud.langfuse.com

# db (users, conversations, chunks (needs pgvector))
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# uploaded knowledge-base zips: `local` (disk) or `azure_blob`
KB_STORAGE__BACKEND=local
KB_STORAGE__DIR=data/uploads
## azure_blob specific (auth via managed identity / `az login`, no keys)
# KB_STORAGE__ACCOUNT_URL=https://<account>.blob.core.windows.net
# KB_STORAGE__CONTAINER=kb-archives

# auth (use random secret, e.g. `openssl rand -hex 32`)
AUTH__JWT_SECRET=dev-only-insecure-jwt-secret-change-me
