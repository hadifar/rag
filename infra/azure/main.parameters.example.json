{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": { "value": "rag" },
    "keyVaultName": { "value": "rag-kv" },
    "acrName": { "value": "ragacr" },
    "acrSku": { "value": "Basic" },
    "backendContainerImageName": { "value": "rag-backend:<tag>" },
    "frontendContainerImageName": { "value": "rag-frontend:<tag>" },
    "ciServicePrincipalObjectId": { "value": "<ci-service-principal-object-id>" },
    "appServicePlanSku": { "value": "S1" },

    "llmProvider": { "value": "openai" },

    "pineconeDenseIndexName": { "value": "<dense-index-name>" },
    "pineconeSparseIndexName": { "value": "<sparse-index-name>" },
    "pineconeCloud": { "value": "<cloud>" },
    "pineconeRegion": { "value": "<region>" },
    "pineconeDenseModel": { "value": "<dense-model>" },
    "pineconeSparseModel": { "value": "<sparse-model>" },
    "pineconeNamespace": { "value": "<namespace>" },

    "langfuseEnabled": { "value": true },
    "langfuseHost": { "value": "https://cloud.langfuse.com" }
  }
}
