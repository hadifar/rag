# Base images are pinned by version and digest so a rebuild gets the same bytes.
FROM python:3.12.14-slim-trixie@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
COPY --from=ghcr.io/astral-sh/uv:0.11.19@sha256:b46b03ddfcfbf8f547af7e9eaefdf8a39c8cebcba7c98858d3162bd28cf536f6 /uv /uvx /bin/
WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY rag/ rag/
COPY alembic.ini ./
COPY migrations/ migrations/

COPY README.md ./
RUN uv sync --frozen --no-dev

# Unprivileged runtime user. /app stays root-owned, so the app cannot rewrite its own code.
# The uploads dir is created here so a new named volume mounted on it inherits this owner.
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin rag \
    && install -d -o rag -g rag /var/lib/rag/uploads
USER rag

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000

ENTRYPOINT ["python", "-m", "rag"]
CMD ["serve"]
