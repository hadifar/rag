# Tighter budget for password guessing;
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;

# Knowledge-base uploads + status polling (~1 request per 2s while a run is going);
limit_req_zone $binary_remote_addr zone=ingestions:10m rate=60r/m;

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    # Inherited by every proxied location below (none sets its own).
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";

    # Same paths the Vite dev server proxies (see frontend/vite.config.ts).
    # BACKEND_URL is env-substituted at container start (nginx:alpine's built-in
    # /etc/nginx/templates/*.template handling) — docker-compose.yml's backend
    # service on one side, the backend Web App's hostname (main.bicep) on the other.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        # POST /api/chat/{id} is SSE: don't buffer or time out mid-response.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # Login — rate limited
    location = /api/auth/login {
        limit_req zone=login burst=3 nodelay;
        limit_req_status 429;
        proxy_pass ${BACKEND_URL};
    }

    # Ingestion — rate limited
    location /api/ingestions {
        limit_req zone=ingestions burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size ${KB_BODY_MAX_BYTES};
        proxy_pass ${BACKEND_URL};
    }

    # Upload body limits: the backend's UPLOADS__* settings, plus multipart framing
    # (see upload-limits.envsh).
    location = /api/skills {
        client_max_body_size ${SKILL_BODY_MAX_BYTES};
        proxy_pass ${BACKEND_URL};
    }

    location ~ ^/api/conversations/[^/]+/attachments$ {
        client_max_body_size ${ATTACHMENT_BODY_MAX_BYTES};
        proxy_pass ${BACKEND_URL};
    }

    location / {
        try_files $uri /index.html;
    }
}
